{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/node.ts", "src/worker.ts"],
  "entryPointStrategy": "resolve",
  // Function pages go in function/, not functions/, which Cloudflare Pages leaves out of an upload (scripts/typedoc-router.mjs).
  "plugin": ["./scripts/typedoc-router.mjs"],
  "router": "any2orca",
  "tsconfig": "tsconfig.json",
  "name": "any2orca API reference",
  // Where the reference is published: TypeDoc adds a canonical link to every page and writes sitemap.xml with it.
  "hostedBaseUrl": "https://docs.any2orca.com/",
  "readme": "README.md",
  "out": "../../api-docs",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  // No "Member Visibility" checkboxes in the reference's Settings panel: the public API has no protected members,
  // and members inherited from our own classes (code and name on ProfileDataError, from Any2orcaError) read best
  // always listed. If a filter is needed later, add it back here, e.g. "visibilityFilters": { "inherited": true },
  // and drop excludeProtected.
  "excludeProtected": true,
  "visibilityFilters": {},
  "navigation": { "includeCategories": false, "includeGroups": true },
  "validation": { "invalidLink": true, "notExported": false },
  "treatWarningsAsErrors": false,
  "githubPages": false,
  "hideGenerator": true
}
