{
  "topLevel": [
    "help",
    "--help",
    "-h",
    "version",
    "--version",
    "-v"
  ],
  "commands": {
    "convert": {
      "positionals": "<files...>",
      "options": {
        "profile": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "above-stock": {
          "type": "string"
        },
        "keep": {
          "type": "string",
          "multiple": true
        },
        "use-stock": {
          "type": "string",
          "multiple": true
        },
        "keep-higher": {
          "type": "string",
          "multiple": true
        },
        "filament-compliance": {
          "type": "string"
        },
        "high-flow": {
          "type": "boolean",
          "default": false
        },
        "high-flow-toolheads": {
          "type": "string"
        },
        "hardened-nozzle": {
          "type": "boolean",
          "default": false
        },
        "no-stamp": {
          "type": "boolean",
          "default": false
        },
        "max-unpacked": {
          "type": "string"
        },
        "explain": {
          "type": "boolean",
          "default": false
        },
        "explain-json": {
          "type": "boolean",
          "default": false
        },
        "out-dir": {
          "type": "string"
        },
        "suffix": {
          "type": "string",
          "default": "_U1"
        },
        "dry-run": {
          "type": "boolean",
          "default": false
        },
        "verbose": {
          "type": "boolean",
          "default": false
        },
        "skip-existing": {
          "type": "boolean",
          "default": false
        },
        "watch": {
          "type": "string"
        },
        "archive-dir": {
          "type": "string"
        },
        "log-file": {
          "type": "string"
        },
        "quiet": {
          "type": "boolean",
          "default": false
        },
        "profiles-dir": {
          "type": "string"
        },
        "snapmaker-orca-version": {
          "type": "string"
        },
        "dry-run-telemetry": {
          "type": "boolean",
          "default": false
        },
        "stats-endpoint": {
          "type": "string"
        }
      }
    },
    "diff": {
      "positionals": "<a.3mf> [<b.3mf>]",
      "options": {
        "group": {
          "type": "string",
          "multiple": true
        },
        "all": {
          "type": "boolean",
          "default": false
        },
        "sort": {
          "type": "string"
        },
        "json": {
          "type": "boolean",
          "default": false
        },
        "profiles-dir": {
          "type": "string"
        },
        "snapmaker-orca-version": {
          "type": "string"
        },
        "against-preset": {
          "type": "string"
        },
        "against-stock": {
          "type": "string",
          "optionalValue": true
        }
      }
    },
    "presets": {
      "subcommands": [
        "add",
        "list",
        "show",
        "remove",
        "export",
        "import"
      ],
      "options": {
        "above-stock": {
          "type": "string"
        },
        "keep": {
          "type": "string",
          "multiple": true
        },
        "force": {
          "type": "boolean",
          "default": false
        },
        "json": {
          "type": "boolean",
          "default": false
        },
        "out": {
          "type": "string"
        },
        "profiles-dir": {
          "type": "string"
        },
        "snapmaker-orca-version": {
          "type": "string"
        }
      }
    },
    "profiles": {
      "options": {
        "nozzle": {
          "type": "string"
        },
        "profiles-dir": {
          "type": "string"
        },
        "snapmaker-orca-version": {
          "type": "string"
        }
      }
    },
    "telemetry": {
      "subcommands": [
        "show",
        "on",
        "off",
        "clear",
        "update-check on",
        "update-check off"
      ],
      "options": {}
    }
  },
  "environmentVariables": [
    "ANY2ORCA_CONFIG_DIR",
    "ANY2ORCA_STATS_ENDPOINT",
    "ANY2ORCA_TELEMETRY",
    "APPDATA",
    "CI",
    "DO_NOT_TRACK",
    "NO_UPDATE_NOTIFIER",
    "XDG_CONFIG_HOME"
  ]
}
