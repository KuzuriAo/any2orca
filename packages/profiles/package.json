{
  "name": "any2orca-profiles",
  "version": "0.0.0",
  "description": "Snapmaker U1 profile catalog for any2orca, generated from Snapmaker Orca's own presets. Data only.",
  "keywords": [
    "snapmaker",
    "snapmaker-u1",
    "orcaslicer",
    "snapmaker-orca",
    "printer-profiles",
    "3d-printing",
    "3mf"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./index.json": "./data/index.json",
