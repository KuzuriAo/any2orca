  },
  "files": [
    "data",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node scripts/generate.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KuzuriAo/any2orca.git",
    "directory": "packages/profiles"
  },
  "homepage": "https://github.com/KuzuriAo/any2orca",
