{
  "name": "@any2orca/web",
  "version": "0.0.0",
  "private": true,
  "description": "any2orca's web UI. A static site built on packages/core; not published to npm. Released as a prebuilt dist/ tarball attached to GitHub Releases, for self-hosting.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "copy-profiles": "node scripts/copy-profiles.mjs",
    "predev": "node scripts/copy-profiles.mjs && node scripts/copy-licenses.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-profiles.mjs && node scripts/copy-licenses.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "node scripts/check-skins.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "npm run build:e2e && playwright test",
    "copy-licenses": "node scripts/copy-licenses.mjs"
  },
  "dependencies": {
    "any2orca": "0.0.1",
    "any2orca-profiles": "0.0.0",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
