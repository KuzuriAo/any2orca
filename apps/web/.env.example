# Which theme to build: "oss" (default neutral open-source skin) or "a2o" (the any2orca.com skin).
# VITE_BRAND=oss

# The site address used for canonical links, preview metadata, and sitemaps.
# Accepts http: or https: URLs without credentials, query strings, or fragments (supports subpaths, e.g. "https://example.com/tools/any2orca").
# An unset build is an unofficial copy with no canonical URL, sitemap, or Google site verification.
# Set to "https://any2orca.com" for the official deployment, or "none" for a private, non-indexed copy (adds noindex, nofollow and Disallow: /).
# VITE_SITE_URL=https://any2orca.com

# Optional comma-separated list of landing sections to hide at build time.
# Allowed values: beyond, faq, integrate, support (e.g. "beyond,faq").
# VITE_HIDE_SECTIONS=
